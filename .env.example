# ── Banco de dados ──────────────────────────────────────────
# Gerado pelo setup-vps.sh com os dados reais da VPS
DATABASE_URL="postgresql://camserv_app:SENHA@IP_DA_VPS:5432/camserv_crm"

# ── Autenticação (NextAuth) ──────────────────────────────────
NEXTAUTH_URL="http://IP_DA_VPS"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
