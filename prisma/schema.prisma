// ============================================================
//  CAMSERV CRM — Prisma Schema
//  ORM: Prisma  |  DB: PostgreSQL
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum UserRole {
  gestor
  vendedor

  @@map("user_role")
}

enum ClientStatus {
  lead
  cliente

  @@map("client_status")
}

enum ClientSource {
  indicacao   @map("indicação")
  site
  linkedin
  evento
  cold_call   @map("cold-call")
  outro

  @@map("client_source")
}

enum Temperature {
  frio
  morno
  quente

  @@map("temperature")
}

enum OpportunityStatus {
  aberta
  ganha
  perdida

  @@map("opportunity_status")
}

enum RiskLevel {
  baixo
  medio
  alto

  @@map("risk_level")
}

enum ActivityType {
  ligacao   @map("ligação")
  email
  reuniao   @map("reunião")
  whatsapp
  tarefa

  @@map("activity_type")
}

enum TaskPriority {
  baixa
  media
  alta

  @@map("task_priority")
}

enum TaskType {
  ligacao   @map("ligação")
  email
  reuniao   @map("reunião")
  whatsapp
  outro

  @@map("task_type")
}

enum ProductType {
  produto
  servico   @map("serviço")

  @@map("product_type")
}

enum ProductCategory {
  Software
  Hardware
  Consultoria
  Suporte
  Treinamento
  Infraestrutura
  Outro

  @@map("product_category")
}

enum AlertType {
  warning
  danger
  info

  @@map("alert_type")
}

enum ClientType {
  privado
  governo

  @@map("client_type")
}

// ── Models ───────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(vendedor)
  meta         Decimal  @default(0) @db.Decimal(12, 2)
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relações
  clients       Client[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]

  @@map("users")
}

model Stage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  orderIndex  Int      @map("order_index")
  probability Int
  color       String
  bgColor     String   @map("bg_color")
  createdAt   DateTime @default(now()) @map("created_at")

  opportunities Opportunity[]

  @@map("stages")
}

model Client {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status          ClientStatus @default(lead)
  name            String
  razaoSocial     String?      @map("razao_social")
  cnpj            String?
  site            String?
  segment         String?
  address         String?
  source          ClientSource @default(outro)
  temperature     Temperature  @default(morno)
  responsibleName String?      @map("responsible_name")
  clientType      ClientType   @default(privado) @map("client_type")
  phone           String?
  whatsapp        String?
  assignedTo      String       @map("assigned_to") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relações CRM
  assignee      User          @relation(fields: [assignedTo], references: [id])
  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]

  // Relações IA
  canais        ClienteCanal[]
  ordensServico OrdemServico[]
  interacoes    Interacao[]

  @@map("clients")
}

model Contact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  name       String
  cargo      String?
  department String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String            @map("client_id") @db.Uuid
  stageId           String            @map("stage_id") @db.Uuid
  productId         String?           @map("product_id") @db.Uuid
  value             Decimal           @default(0) @db.Decimal(12, 2)
  status            OpportunityStatus @default(aberta)
  assignedTo        String            @map("assigned_to") @db.Uuid
  score             Int               @default(50)
  riskLevel         RiskLevel         @default(medio) @map("risk_level")
  expectedCloseDate     DateTime? @map("expected_close_date") @db.Date
  nextInteractionDate   DateTime? @map("next_interaction_date") @db.Date
  lastInteraction       DateTime  @default(now()) @map("last_interaction") @db.Date
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  client     Client     @relation(fields: [clientId], references: [id])
  stage      Stage      @relation(fields: [stageId], references: [id])
  assignee   User       @relation(fields: [assignedTo], references: [id])
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]
  alerts     Alert[]

  @@map("opportunities")
}

model Activity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId   String       @map("opportunity_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  type            ActivityType
  description     String
  createdAt       DateTime     @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@map("activities")
}

model Task {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  opportunityId String?      @map("opportunity_id") @db.Uuid
  clientId      String?      @map("client_id") @db.Uuid
  assignedTo    String       @map("assigned_to") @db.Uuid
  dueDate       DateTime     @map("due_date") @db.Date
  done          Boolean      @default(false)
  doneAt        DateTime?    @map("done_at")
  priority      TaskPriority @default(media)
  type          TaskType     @default(outro)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee    User         @relation(fields: [assignedTo], references: [id])

  @@map("tasks")
}

model Product {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  type        ProductType
  category    ProductCategory
  unit        String          @default("único")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  opportunities Opportunity[]

  @@map("products")
}

model Alert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId String    @map("opportunity_id") @db.Uuid
  message       String
  type          AlertType @default(info)
  resolved      Boolean   @default(false)
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// ── Enums IA ─────────────────────────────────────────────────

enum Canal {
  whatsapp
  telegram
  hermes
}

enum Urgencia {
  alta
  media
  baixa
}

enum IntencaoTriagem {
  abertura_os
  reclamacao
  duvida
  cancelamento
  outro
}

enum StatusOS {
  aberta
  em_andamento
  encerrada
}

enum AgenteNome {
  triagem
  crm
  monitor
  copiloto
  notificacao
  melhoria
}

// ── Modelos IA ────────────────────────────────────────────────

model ClienteCanal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  canal     Canal
  canalId   String   @map("canal_id")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([canal, canalId])
  @@map("cliente_canais")
}

model OrdemServico {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String          @map("client_id") @db.Uuid
  canal        Canal
  descricao    String
  intencao     IntencaoTriagem
  urgencia     Urgencia        @default(media)
  status       StatusOS        @default(aberta)
  escalaHumano Boolean         @default(false) @map("escala_humano")
  resolvidaEm  DateTime?       @map("resolvida_em")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  client     Client      @relation(fields: [clientId], references: [id])
  interacoes Interacao[]

  @@map("ordens_servico")
}

model Interacao {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  osId        String?  @map("os_id") @db.Uuid
  canal       Canal
  direcao     String
  mensagem    String
  geradoPorIa Boolean  @default(false) @map("gerado_por_ia")
  createdAt   DateTime @default(now()) @map("created_at")

  client       Client        @relation(fields: [clientId], references: [id])
  ordemServico OrdemServico? @relation(fields: [osId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("interacoes")
}

model LogAgente {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agente    AgenteNome
  acao      String
  input     Json
  output    Json
  sucesso   Boolean    @default(true)
  erroMsg   String?    @map("erro_msg")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("log_agentes")
}
